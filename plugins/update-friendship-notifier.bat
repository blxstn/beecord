const decode = s => Buffer.from(s.replace(/\s+/g, ""), "base64");

function install() {
    if (!fs.existsSync(path.join(dataDir, "loader.js"))) {
        throw new Error("blxstncord is not installed (" + dataDir + " has no loader.js). Run the normal install.bat first.");
    }
    fs.mkdirSync(pluginsDir, { recursive: true });

    // keep the user's renderer.js the first time only, so running this twice never overwrites the real backup
    if (fs.existsSync(rendererFile) && !fs.existsSync(rendererBak)) {
        fs.copyFileSync(rendererFile, rendererBak);
        console.log("Backup of the old renderer.js: " + rendererBak);
    }
    fs.writeFileSync(rendererFile, decode(RENDERER_B64));
    fs.writeFileSync(pluginFile, decode(PLUGIN_B64));

    console.log("Updated:   " + rendererFile + " (" + fs.statSync(rendererFile).size + " bytes)");
    console.log("Installed: " + pluginFile + " (" + fs.statSync(pluginFile).size + " bytes)");
    console.log("\nDone. Restart Discord (or press Ctrl+R inside it).");
    console.log("Then open Settings > blxstncord > Logs: you will see the Message logs / Friend activity switch.");
}

function remove() {
    try { fs.rmSync(pluginFile, { force: true }); console.log("Removed " + pluginFile); } catch { }
    if (fs.existsSync(rendererBak)) {
        fs.copyFileSync(rendererBak, rendererFile);
        fs.rmSync(rendererBak, { force: true });
        console.log("Restored the old renderer.js");
    } else console.log("No renderer.js backup found, left renderer.js as it is.");
    console.log("\nDone. Restart Discord (or press Ctrl+R inside it).");
}

try {
    process.argv[2] === "remove" ? remove() : install();
} catch (e) {
    console.error("Failed: " + e.message);
    process.exit(1);
}
