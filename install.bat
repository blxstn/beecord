/* 2>nul
@echo off
title blxstncord installer
where node >nul 2>nul || (echo Node.js was not found. Install it from https://nodejs.org and run this file again. & pause & exit /b 1)
node "%~f0" %*
echo.
pause
exit /b
*/
// blxstncord installer (Windows), everything in ONE file: core, auto-updater and all plugins are embedded below.
//   install.bat            -> install / update (plugins are written to %APPDATA%\blxstncord\plugins) and restart Discord
//   install.bat uninstall  -> remove (also stops the auto-updater; plugins and settings are kept)
//   install.bat log        -> show %APPDATA%\blxstncord\log.txt
// Discord is restarted automatically (the open window closes and comes back), no need to close it yourself.
// After that a small background watcher keeps everything up to date by itself:
//   - plugins added/edited in %APPDATA%\blxstncord\plugins load live, without restarting Discord
//   - drop a plugin .js or a newer install.bat into %APPDATA%\blxstncord\inbox and it is applied automatically
//   - Discord updates are re-patched automatically

